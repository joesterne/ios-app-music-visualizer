// Use Xcode 16 or newer. No third-party Swift packages are required.
SWIFT_VERSION = 5.0
SWIFT_STRICT_CONCURRENCY = targeted
CLANG_C_LANGUAGE_STANDARD = gnu11
CLANG_ENABLE_MODULES = YES
ENABLE_HARDENED_RUNTIME = YES
SWIFT_OBJC_BRIDGING_HEADER = $(SRCROOT)/Config/Afterglow-Bridging-Header.h
HEADER_SEARCH_PATHS = $(inherited) $(SRCROOT)/Core
GENERATE_INFOPLIST_FILE = NO
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon
MARKETING_VERSION = 0.1.0
CURRENT_PROJECT_VERSION = 1
PRODUCT_NAME = Afterglow
// Replace this prefix with your own unique reverse-domain identifier before signing.
BUNDLE_ID_PREFIX = com.example.afterglow
// Change to YES after enabling MusicKit on your App IDs in Apple Developer.
// This enables the in-app connection UI. Apple authorization and signing are still required.
AFTERGLOW_MUSICKIT_ENABLED = NO
